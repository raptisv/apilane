{
  // Committed defaults with local-development sample values. Override any of them in
  // appsettings.{Environment}.json (git-ignored) or with environment variables, using "__" for nesting
  // (e.g. FileStorage__Provider=AwsS3). The docker-compose setup uses environment variables.

  // Address the API listens on. In Docker: http://0.0.0.0:5001
  "Url": "http://localhost:5001",
  // URL of the Portal, as reachable by the API.
  "PortalUrl": "http://localhost:5000",
  // Folder for the applications' SQLite databases and local files. In Docker: a mounted volume, e.g. /etc/apilanewebapi/Files
  "FilesPath": "C:\\src\\Apilane\\DatabaseFiles\\Files",
  // Shared secret with the Portal; must equal the Portal's key (Admin > Settings). Use a long random value
  // (e.g. openssl rand -hex 32). The placeholder logs a SECURITY warning at startup. Never deploy it.
  "InstallationKey": "REPLACE-WITH-A-LONG-RANDOM-SECRET",
  // Optional minimum number of .NET thread pool worker threads.
  "MinThreads": 50,
  // Where uploaded files are stored. Keep credentials in appsettings.{Environment}.json or environment variables.
  "FileStorage": {
    "Provider": "LocalFileSystem"
    // Google Cloud Storage:
    // "Provider": "GoogleCloudStorage",
    // "ConnectionString": "/run/secrets/gcs-sa.json",  // Path to service account JSON
    // "BucketName": "my-app-files-bucket"
    //
    // AWS S3 or S3-compatible (e.g., Backblaze B2):
    // "Provider": "AwsS3",
    // "ConnectionString": "AccessKey=AKIA...;SecretKey=...;Region=us-east-1",
    // "BucketName": "my-app-files-bucket"
    //
    // Azure Blob Storage:
    // "Provider": "AzureBlobStorage",
    // "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net",
    // "BucketName": "my-container-name"  // Container name
  },
  // Orleans clustering. Localhost for a single server; Redis or AdoNet for several servers, e.g.
  // "Type": "Redis", "Redis": { "ConnectionString": "..." } or
  // "Type": "AdoNet", "AdoNet": { "ConnectionString": "...", "Invariant": "System.Data.SqlClient" }
  "Clustering": {
    "ClusterId": "apilane_api_cluster",
    "ServiceId": "apilane_api_service",
    "Type": "Localhost",
    "SiloPort": 11111,
    "GatewayPort": 30000
  },
  // Prometheus metrics at /metrics, and OTLP tracing to Url when Tracing.Enabled is true.
  "OpenTelemetry": {
    "Metrics": {
      "Enabled": true
    },
    "Tracing": {
      "Enabled": false,
      "Url": "http://localhost:4317",
      "SampleRatio": 0.1,
      "LogSpans": true
    }
  },
  // File extensions that cannot be uploaded.
  "InvalidFilesExtentions": [ ".exe", ".vbs", ".msi", ".jar", ".bat", ".cmd", ".vbe", ".js", ".jsp", ".lnk" ],
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      }
      // Graylog, as a second sink (environment variables: Serilog__WriteTo__1__...):
      // , { "Name": "Graylog", "Args": { "facility": "Apilane.Api", "hostnameOrAddress": "graylog", "port": 12201, "transportType": "Udp" } }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessName"
    ],
    "Using": [ "Serilog.Expressions" ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath IN ['/metrics', '/health/liveness', '/health/readiness'] AND StatusCode = 200"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Warning",
        "Microsoft.AspNetCore.Authorization.DefaultAuthorizationService": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.Mvc.Internal": "Warning",
        "Microsoft.AspNetCore.Mvc": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.AspNetCore.Cors.Infrastructure.CorsService": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
      }
    }
  }
}

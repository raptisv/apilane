@using Apilane.Common.Models;
@model Apilane.Api.Areas.Account.Models.ResetPasswordViewModel

@{
    Layout = "~/Areas/Account/Views/Shared/_Layout.cshtml";

    DBWS_Application Application = (DBWS_Application)ViewBag.Application;
}

<h1>@Application.Name</h1>
<p>Reset your password</p>

@using (Html.BeginForm("ResetPassword", "Manage", new { Token = ViewBag.Token }, FormMethod.Post, true, null))
{
    <div class="account-field">
        <label for="Email">Email</label>
        @Html.TextBoxFor(m => m.Email, new { type = "email", maxlength = 50, autocomplete = "email" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "account-error" })
    </div>
    <div class="account-field">
        <label for="Password">Password</label>
        @Html.PasswordFor(m => m.Password, new { autocomplete = "new-password" })
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "account-error" })
    </div>
    <div class="account-field">
        <label for="ConfirmPassword">Confirm password</label>
        @Html.PasswordFor(m => m.ConfirmPassword, new { autocomplete = "new-password" })
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "account-error" })
    </div>
    @Html.ValidationSummary(true, "", new { @class = "account-error" })
    <button type="submit">Reset</button>
}

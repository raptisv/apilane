@using Apilane.Common.Models;
@model Apilane.Api.Areas.Account.Models.ForgotPasswordViewModel

@{
    Layout = "~/Areas/Account/Views/Shared/_Layout.cshtml";

    DBWS_Application Application = (DBWS_Application)ViewBag.Application;
}

<h1>@Application.Name</h1>
<p>Enter your email address that you used to register. We'll send you an email with a link to reset your password.</p>

@using (Html.BeginRouteForm("areas", new { controller = "Manage", action = "ForgotPassword" }, FormMethod.Post, true, null))
{
    <div class="account-field">
        <label for="Email">Email</label>
        @Html.TextBoxFor(m => m.Email, new { type = "email", maxlength = 50, autocomplete = "email" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "account-error" })
    </div>
    <button type="submit">Send the email</button>
}

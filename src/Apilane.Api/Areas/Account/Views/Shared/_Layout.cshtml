@using Apilane.Common.Models;

@{
    DBWS_Application Application = ViewBag.Application;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Application.Name</title>
    <link rel="icon" href="~/favicon.ico" type="image/x-icon">
    @* The query string changes with the stylesheet, so a browser that cached an older one fetches the new one. *@
    <link rel="stylesheet" href="@Url.Content("~/assets/account.css")?v=2">
</head>
<body>
    <main class="account-card">
        @RenderBody()
    </main>
    <script>
        // A second click must not send the form twice.
        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', function () {
                var button = form.querySelector('button[type="submit"]');
                if (button) {
                    button.disabled = true;
                    button.textContent = 'Please wait...';
                }
            });
        });
    </script>
</body>
</html>

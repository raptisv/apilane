@using Apilane.Common.Models;

@model DBWS_Application

@{
    ViewBag.Title = Model.Name + " - Data browser";
    Layout = "~/Views/Shared/_LayoutData.cshtml";
}

<div>
    <div>
        <div class="card my-4 border-0" x-data="{ activeTab: '@Model.Entities.First().Name' }">
            <ul class="nav-entities nav nav-pills" role="tablist">
                @for (int i = 0; i < Model.Entities.Count; i++)
                {
                    DBWS_Entity ent = Model.Entities[i];

                    <li class="nav-item" role="presentation">
                        <a id="link-entity-@ent.Name" class="nav-link" :class="{ active: activeTab === '@ent.Name' }" href="#@ent.Name" @@click="activeTab = '@ent.Name'" role="tab" data-entity="@ent.Name" rel="@Url.RouteUrl("EntRoute", new { controller = "Entity", action = "Data", appid = Model.Token, entid = ent.Name })">@ent.Name</a>
                    </li>
                }
            </ul>
            <div class="tab-content mt-4 border border-zinc-800">
                @for (int i = 0; i < Model.Entities.Count; i++)
                {
                    DBWS_Entity ent = Model.Entities[i];
                    <div class="tab-pane" x-show="activeTab === '@ent.Name'" id="@ent.Name" role="tabpanel"></div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts{
<script>
     $(document).ready(function () {

        loadTabFrame($('#link-entity-@Model.Entities.First().Name').attr("href"), $('#link-entity-@Model.Entities.First().Name').attr("rel"));

        $(".nav-entities a").click(function () {
            loadTabFrame($(this).attr("href"), $(this).attr("rel"));
        });

        //tab switching function
        function loadTabFrame(tab, url) {
            if ($(tab).find("iframe").length == 0) {
                $(tab).append(`<div class="openout"></div><iframe class="iframetab w-full" src="${url}"></iframe>`);
            }
            $(tab).find("iframe").height($(window).height() - $('.nav-entities').offset().top - 150);
            return false;
        }
     });
</script>
}

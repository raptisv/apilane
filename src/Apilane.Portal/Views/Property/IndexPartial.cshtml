@using Apilane.Portal.Models;
@using Apilane.Common;
@using Apilane.Common.Models;
@using Microsoft.AspNetCore.Http;
@model List<DBWS_EntityProperty>

<div class="table-responsive">
    <table class="table table-sm table-borderless table-hover m-0">
        <thead>
            <tr>
                <th>Property</th>
                <th>Type</th>
                <th>Constraints</th>
                @if (Model.Any(x => !x.IsSystem))
                {
                    <th style="width:1px;">Options</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderByDescending(x => x.IsPrimaryKey).ThenBy(x => x.IsSystem).ThenBy(x => x.Name))
            {
                var df = item.Descr().Select(x => Html.Raw(x.Replace("'", "&#39;")));
                string descr = string.Join("", df.Select(x => $"<div class='badge bg-zinc-800 text-zinc-200 me-1'>{x}</div>"));
                <tr>
                    <td>
                        <strong class="text-primary">@item.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <i class="bi bi-info-circle text-primary" title="@item.Description"></i>
                        }
                    </td>
                    <td><div class="badge bg-zinc-800 text-zinc-200">@item.TypeID_Enum.ToString()</div></td>
                    <td>@Html.Raw(descr)</td>

                    @if (Model.Any(x => !x.IsSystem))
                    {
                        <td>
                            @if (item.IsSystem == false)
                            {
                                <div class="dropdown" x-data="{ open: false }" @@click.outside="open = false">
                                    <button class="btn btn-sm btn-default" type="button" @@click="open = !open">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    <div class="dropdown-menu" x-show="open" x-transition x-cloak @@click="open = false">
                                        <a class="dropdown-item" href="@Url.RouteUrl("PropRoute", new { controller = "Property", action = "Edit", appid = Html.GetAppToken(), entid = Html.GetEntName(), propid = item.Name })" title="Edit">
                                            Edit
                                        </a>
                                        <a class="dropdown-item @(item.IsSystem ? "pointer-events-none opacity-40" : "")" title="@(item.IsSystem ? "Cannot rename system Properties" : "")" href="@(item.IsSystem ? "#" : Url.RouteUrl("PropRoute", new { controller = "Property", action = "Rename", appid = Html.GetAppToken(), entid = Html.GetEntName(), propid = item.Name }))">
                                            Rename
                                        </a>
                                        <hr class="dropdown-divider" />
                                        <a class="dropdown-item" href="@Url.RouteUrl("PropRoute", new { controller = "Property", action = "Delete", appid = Html.GetAppToken(), entid = Html.GetEntName(), propid = item.Name })" title="Delete">
                                            Delete
                                        </a>
                                    </div>
                                </div>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
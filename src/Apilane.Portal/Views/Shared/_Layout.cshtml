@using Apilane.Portal.Models;
@using Apilane.Common.Models;
@using Apilane.Common;
@using Apilane.Common.Utilities;
@using Apilane.Common.Enums;
@using Apilane.Portal.Abstractions;
@using Microsoft.AspNetCore.Http;
@inject IPortalSettingsService _portalSettingsService;
@{
    string SelectedAppToken = Html.GetAppToken();
    string SelectedEntity = Html.GetEntName();
    string SelectedPropery = Html.GetPropName();
    string Controller = Html.Controller();
    string Action = Html.Action();

    var Applications = (List<DBWS_Application>)ViewBag.Applications;
    var isAdmin = User.IsInRole(Globals.AdminRoleName);
    var settings = _portalSettingsService.Get();
}

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <title>@settings.InstanceTitle | @ViewBag.Title</title>
    <meta name="robots" content="noindex, nofollow">
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="IE=edge,chrome=1">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0">
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <link rel="stylesheet" href="~/assets/vendor/tailwind/tailwind.css?v=@Html.AssetVersion()">
    <link rel="stylesheet" href="~/site.min.css?v=@Html.AssetVersion()">
    <link rel="stylesheet" href="~/assets/vendor/sweetalert/sweetalert2.dark.css?v=@Html.AssetVersion()">

    @RenderSection("styles", required: false)
</head>
<body class="bg-black text-zinc-200" x-data="{}">
    <div x-data="{ navOpen: false }" class="fixed top-0 inset-x-0 z-40 border-b border-zinc-800 bg-zinc-950/95 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-2.5">
            <img src="~/favicon.ico" class="app-logo" />
            <a href="@Url.Action("Index", "Applications")" class="text-lg font-semibold text-zinc-100 hover:text-zinc-100">@settings.InstanceTitle</a>

            <button type="button" class="ml-auto rounded-md p-2 text-zinc-300 hover:bg-zinc-900 lg:hidden" @@click="navOpen = !navOpen" aria-label="Toggle navigation">
                <i class="bi bi-list text-xl"></i>
            </button>

            <div class="w-full flex-col gap-1 lg:ml-2 lg:flex lg:flex-1 lg:flex-row lg:items-center" :class="navOpen ? 'flex' : 'hidden'">
                <ul class="flex flex-col lg:flex-row lg:items-center">
                    @if (Applications.Any())
                    {
                        var groupedByServer = Applications.GroupBy(x => x.Server);

                        <li class="dropdown" x-data="{ open: false }" @@click.outside="open = false">
                            <a class="nav-link flex items-center" href="#" @@click.prevent="open = !open">Applications</a>
                            <div class="dropdown-menu" x-show="open" x-transition x-cloak @@click="open = false">
                                @for (int i = 0; i < groupedByServer.Count(); i++)
                                {
                                    if (i > 0 && i < groupedByServer.Count())
                                    {
                                        <hr class="dropdown-divider" />
                                    }
                                    if (groupedByServer.ElementAt(i).Count() > 0)
                                    {
                                        <b class="dropdown-item no-hover fw-bold pe-none">
                                            @groupedByServer.ElementAt(i).Key.Name
                                        </b>
                                        @foreach (var app in groupedByServer.ElementAt(i))
                                        {
                                            <a class="dropdown-item" href="@Url.RouteUrl("AppRoute", new {controller = "Application", action = "Entities", appid = app.Token })">@app.Name</a>
                                        }
                                    }
                                }
                            </div>
                        </li>
                    }
                    @if (isAdmin)
                    {
                        <li class="dropdown" x-data="{ open: false }" @@click.outside="open = false">
                            <a class="nav-link flex items-center" href="#" @@click.prevent="open = !open">Admin</a>
                            <div class="dropdown-menu" x-show="open" x-transition x-cloak @@click="open = false">
                                <a class="dropdown-item" href="@Url.Action("Servers", "Admin")"><i class="bi bi-hdd-rack me-2"></i>Servers</a>
                                <a class="dropdown-item" href="@Url.Action("Users", "Admin")"><i class="bi bi-person me-2"></i>Users</a>
                                <a class="dropdown-item" href="@Url.Action("UserApplications", "Admin")"><i class="bi bi-window me-2"></i>Applications</a>
                                <a class="dropdown-item" href="@Url.Action("Settings", "Admin")"><i class="bi bi-gear me-2"></i>Settings</a>
                                <a class="dropdown-item" href="@Url.Action("AuditLog", "Admin")"><i class="bi bi-clock-history me-2"></i>Audit log</a>
                                <hr class="dropdown-divider" />
                                <a class="dropdown-item" href="@Url.Action("BackupDatabase",  "Admin")"><i class="bi bi-download me-2"></i>Backup database</a>
                            </div>
                        </li>
                    }
                </ul>
                <ul class="flex flex-col lg:ml-auto lg:flex-row lg:items-center">
                    <li class="me-2">
                        <a class="nav-link flex items-center" href="https://github.com/raptisv/apilane" target="_blank">
                            <span><i class="bi bi-github me-2"></i>@("v" + Html.AssemblyVersion())</span>
                        </a>
                    </li>
                    <li class="dropdown" x-data="{ open: false }" @@click.outside="open = false">
                        <a class="nav-link flex items-center" href="#" @@click.prevent="open = !open">
                            <i class="bi bi-person-circle"></i>
                            <span class="ms-2 lg:hidden">@User.Identity!.GetUserEmail()</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end" x-show="open" x-transition x-cloak @@click="open = false">
                            <a href="@Url.Action("ChangePassword", "Manage")" class="dropdown-item flex items-center">
                                <i class="bi bi-key me-1"></i><span class="ms-2">Change password</span>
                            </a>
                            <a href="@Url.Action("LogOff", "Account")" class="dropdown-item flex items-center">
                                <i class="bi bi-box-arrow-right me-1"></i><span class="ms-2">Sign out</span>
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="mx-auto max-w-7xl px-4 pt-20">

        @RenderBody()

        <footer id="footer" class="my-8 border-t border-zinc-800 pt-4">
            <a target="_blank" href="https://apilane.com" class="text-zinc-400">Apilane © @DateTime.Now.Year</a>
        </footer>
    </div>

    <script src="~/assets/vendor/alpinejs/alpine-collapse.min.js" defer></script>
    <script src="~/assets/alpine-app.js" defer></script>
    <script src="~/assets/vendor/alpinejs/alpine.min.js" defer></script>
    <script type="text/javascript" src="~/site.min.js?v=@Html.AssetVersion()"></script>
    <script type="text/javascript">
        var UrlSiteBase = '@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.PathBase)';
        @foreach (var app in Applications)
        {
            @:loadApplicationDisplayToken(@app.ID, '@app.Token', '@(app.EncryptionKey.Decrypt(Globals.EncryptionKey))', '@app.Server.ServerUrl');
        }

            jQuery.fn.addHidden = function (name, value) {
                return this.each(function () {
                    var input = $("<input>").attr("type", "hidden").attr("name", name).val(value);
                    $(this).append($(input));
                });
            };
    </script>
    @RenderSection("scripts", required: false)
    @Html.PageScripts()
</body>
</html>
@{
    ViewBag.Title = "Forgot password confirmation";
    Layout = "~/Views/Shared/_LayoutAccount.cshtml";
}

<div class="card w-full max-w-sm p-8">
    <h4 class="text-zinc-100">Please check your email to reset your password.</h4>
    <hr class="my-4 border-zinc-800" />
    <a href="@Url.Action("Login", "Account")" class="btn btn-primary">Sign in</a>
</div>
